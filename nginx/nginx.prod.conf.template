events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout 65;
    server_tokens   off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;

    # Rate limiting для API
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;

    # Защита от host header injection: допустим только наш домен (задаётся APP_URL)
    map $host $allowed_host {
        hostnames;
        default           0;
        ${APP_DOMAIN}     1;
        www.${APP_DOMAIN} 1;
    }

    upstream laravel {
        server laravel:8000;
    }

    server {
        listen 80;
        server_name ${APP_DOMAIN} www.${APP_DOMAIN};

        # Host header injection: неизвестный host → 444
        if ($allowed_host = 0) {
            return 444;
        }

        # Перенаправляем всё на HTTPS
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name ${APP_DOMAIN} www.${APP_DOMAIN};

        # Сертификаты — положить в ./ssl (см. nginx/ssl-README.md)
        ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        client_max_body_size 100M;

        # Security headers
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-XSS-Protection "0" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        # Host header injection: неизвестный host → 444
        if ($allowed_host = 0) {
            return 444;
        }

        # Next.js static files — кэшируем агрессивно (хэш в имени файла)
        location /_next/static/ {
            root /var/www/frontend;
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
        }

        # Публичные файлы из /public Next.js
        location /public/ {
            root /var/www/frontend;
            expires 7d;
            add_header Cache-Control "public";
            access_log off;
        }

        # API requests → Laravel
        location /api/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://laravel;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 120s;
            proxy_buffering off;
        }

        # Публичные файлы Laravel (thumbnails и т.п.) — /storage → public/storage
        location /storage/ {
            proxy_pass http://laravel;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Sanctum CSRF cookie
        location /sanctum/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://laravel;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Next.js собранное приложение (standalone output)
        location / {
            proxy_pass http://frontend:3000;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
